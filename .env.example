# Copy to .env at the repo root — docker compose reads these to provision the database.
POSTGRES_USER=samozbiory
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=samozbiory-db
POSTGRES_PORT=5432

# Copy to packages/database/.env and apps/web/.env, matching the values above.
DATABASE_URL="postgresql://samozbiory:change_me_locally@localhost:5432/samozbiory-db?schema=public"
