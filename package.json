    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "pnpm": "12.6.0",
    "prettier": "3.9.8",
    "prisma": "8.0.0-rc.17",
    "tsx": "4.23.13",
    "turbo": "^2.11.4"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "pnpm@12.6.0"
}
