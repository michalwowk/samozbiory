{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // NEXT_PUBLIC_SITE_URL is baked into the output: canonicals, sitemap URLs and JSON-LD. Leaving it
      // undeclared would let turbo serve a cached build after a domain change, shipping wrong canonical
      // URLs — a silent SEO failure of exactly the kind ADR 0006 is about.
      "env": ["DATABASE_URL", "NEXT_PUBLIC_SITE_URL"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "db:migrate:dev": {
      "cache": false
    },
    "db:migrate:deploy": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "skills:sync": {
      "cache": false
    },
    "generate": {
      "dependsOn": ["^generate"],
      "env": ["DATABASE_URL"],
      "outputs": ["generated/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"],
      "env": ["DATABASE_URL"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL"]
    },
    "test:e2e": {
      "cache": false,
      "env": ["CI", "DATABASE_URL", "NEXT_PUBLIC_SITE_URL"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "env": ["DATABASE_URL"]
    }
  }
}
